<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>No_Self_Approval</fullName>
    <active>false</active>
    <errorConditionFormula>AND($User.Id = Submitted_By__c, ISPICKVAL(Status__c, &quot;In Review&quot;))</errorConditionFormula>
    <errorDisplayField>Submitted_By__c</errorDisplayField>
    <errorMessage>You cannot submit your own submission for approval.</errorMessage>
</ValidationRule>
