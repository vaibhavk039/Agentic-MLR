<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Citation_Reference_Required</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL(Status__c, &quot;In Review&quot;), ISBLANK(Citation_Reference__c))</errorConditionFormula>
    <errorDisplayField>Citation_Reference__c</errorDisplayField>
    <errorMessage>A Citation Reference is required before submitting for review.</errorMessage>
</ValidationRule>
